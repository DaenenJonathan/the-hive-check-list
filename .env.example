# Copy this file to .env and fill in real values. Never commit .env.

POSTGRES_DB=TheHiveDb
POSTGRES_USER=thehive
POSTGRES_PASSWORD=change_me

# Generate with: openssl rand -base64 48
JWT_KEY=change_me_to_a_random_256_bit_secret

# Public origin of the deployed frontend, e.g. https://checklists.example.com
APP_ORIGIN=http://localhost

# Production only (docker-compose.prod.yml): host port the frontend container
# binds to; point your reverse proxy here. Not used in local dev.
FRONTEND_HTTP_PORT=8080

# SMTP mailbox dedicated to sending account-creation emails (e.g. a
# noreply@yourdomain address if you control the domain, or a Gmail account
# with an app password). Leave empty to disable email sending - account
# creation still works, the generated password is just shown once in the
# admin UI instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=TheHive
